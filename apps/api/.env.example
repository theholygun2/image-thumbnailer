# apps/api/.env.example  (copy to .env, which stays gitignored)

# --- Server (already used by index.ts / app.ts) ---
PORT=3000
APP_URL=http://localhost:5173        # allowed CORS origin; any valid URL if you have no frontend yet

# --- AWS ---
AWS_REGION=ap-southeast-1            # same region as your bucket, queue, and Lambda
S3_BUCKET=your-bucket-name

# --- Upload limits (all optional, these are the defaults) ---
UPLOAD_URL_TTL_SECONDS=300           # presigned POST lifetime
DOWNLOAD_URL_TTL_SECONDS=900         # presigned thumbnail URL lifetime
MAX_UPLOAD_BYTES=10485760            # 10 MB, matching the worker's limit

# Optional, local only: pick a named AWS CLI profile (e.g. an SSO profile)
# AWS_PROFILE=my-profile